# 复制成 deploy/.env 再填自己的值（.env 已在 .gitignore 里）
BOARD_DOMAIN=board.example.com
ACME_EMAIL=you@example.com

# 开通密钥的"规律种子"，必填：本机在仓库根跑 `node publish-api/tools/claim-key.mjs --init`，把打印的那串粘过来。
# 没配 = 谁也不能新建班级（服务端直接 403）。换掉它 = 之前发出去的所有密钥全部作废。
CLAIM_KEY_SECRET=

# 建班时写进班级的服务期（天），默认 365
LICENSE_DAYS=365

# 可选：老师端「创建班级」页开通密钥输入框下面那句话，留空就不显示。
# 官方实例用它告诉试用的人密钥从哪来，例如：
# INVITE_HINT=没有开通密钥？到小红书 26225307944 留言联系作者获取，体验 90 天
INVITE_HINT=

# 可选：大屏端 msi 放哪个目录（不配 = 数据库文件旁边的 downloads/，线上即 /var/lib/class-board/downloads）。
# 老师端「大屏端下载」按钮打 /download/<文件名>，只发这个目录里后缀为 msi/exe/zip 的文件。
# 发版后把新 msi 传进去，文件名要和 index.html 里两处 href 一致。
DOWNLOAD_DIR=
